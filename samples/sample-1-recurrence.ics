BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//ICS Expander Samples//Sample 1//ZH
CALSCALE:GREGORIAN
X-WR-CALNAME:示例日历一（月末·夏令时·单次改期）
BEGIN:VTIMEZONE
TZID:America/New_York
LAST-MODIFIED:20260101T000000Z
BEGIN:DAYLIGHT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:monthly-finance-close@sample
DTSTAMP:20261001T000000Z
SUMMARY:月末结账（全天）
DESCRIPTION:每月最后一天的全天结账日，DTEND 按排他边界处理，跨月天数自动收敛。
DTSTART;VALUE=DATE:20261031
DTEND;VALUE=DATE:20261101
RRULE:FREQ=MONTHLY;BYMONTHDAY=-1
END:VEVENT
BEGIN:VEVENT
UID:weekly-ny-standup@sample
DTSTAMP:20261001T000000Z
SUMMARY:纽约站会（跨夏令时）
DESCRIPTION:始终是纽约当地时间周五 09:00，夏令时 -04:00、冬令时 -05:00，钟点不变。
DTSTART;TZID=America/New_York:20261023T090000
DTEND;TZID=America/New_York:20261023T093000
RRULE:FREQ=WEEKLY;BYDAY=FR;INTERVAL=1
EXDATE;TZID=America/New_York:20261127T090000
RDATE;TZID=America/New_York:20261128T100000
END:VEVENT
BEGIN:VEVENT
UID:team-sync@sample
DTSTAMP:20261001T000000Z
SEQUENCE:0
SUMMARY:团队周会
DESCRIPTION:每周一例会；11 月 16 日那一次改期到周三同时间；11 月 9 日单次取消。
DTSTART;TZID=America/New_York:20261102T140000
DTEND;TZID=America/New_York:20261102T150000
RRULE:FREQ=WEEKLY;BYDAY=MO
END:VEVENT
BEGIN:VEVENT
UID:team-sync@sample
DTSTAMP:20261105T120000Z
SEQUENCE:1
RECURRENCE-ID;TZID=America/New_York:20261116T140000
SUMMARY:团队周会（11/16 改到周三）
DTSTART;TZID=America/New_York:20261118T140000
DTEND;TZID=America/New_York:20261118T150000
DESCRIPTION:例外记录：仅这一次改期，其它周一不变。
END:VEVENT
BEGIN:VEVENT
UID:team-sync@sample
DTSTAMP:20261106T120000Z
SEQUENCE:1
RECURRENCE-ID;TZID=America/New_York:20261109T140000
STATUS:CANCELLED
DTSTART;TZID=America/New_York:20261109T140000
DTEND;TZID=America/New_York:20261109T150000
END:VEVENT
BEGIN:VEVENT
UID:floating-deadline@sample
DTSTAMP:20261001T000000Z
SUMMARY:浮动时间提醒（无时区）
DESCRIPTION:没有 TZID 也没有 Z，按钟面时间原样展示，不做时区换算。
DTSTART:20261120T180000
DTEND:20261120T183000
END:VEVENT
END:VCALENDAR
