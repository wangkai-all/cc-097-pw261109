BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//ICS Expander Samples//Sample 3 unsupported//ZH
CALSCALE:GREGORIAN
X-WR-CALNAME:示例日历三·含未支持规则
BEGIN:VTIMEZONE
TZID:America/New_York
BEGIN:DAYLIGHT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:last-workday-run@sample
DTSTAMP:20261001T000000Z
SUMMARY:每月最后一个工作日跑批（BYSETPOS 未支持）
DESCRIPTION:该规则使用 BYSETPOS=-1，工具不会静默少展开，而是明确列出并只给锚点日程。
DTSTART;VALUE=DATE:20261030
DTEND;VALUE=DATE:20261031
RRULE:FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1
END:VEVENT
BEGIN:VEVENT
UID:hourly-poll@sample
DTSTAMP:20261001T000000Z
SUMMARY:每小时轮询（HOURLY 未支持）
DTSTART;TZID=America/New_York:20261102T090000
DTEND;TZID=America/New_York:20261102T091500
RRULE:FREQ=HOURLY;INTERVAL=2;COUNT=8
END:VEVENT
BEGIN:VEVENT
UID:normal-daily@sample
DTSTAMP:20261001T000000Z
SUMMARY:普通每日站会（对照组，应正常展开）
DTSTART;TZID=America/New_York:20261102T083000
DTEND;TZID=America/New_York:20261102T084500
RRULE:FREQ=DAILY;COUNT=5
END:VEVENT
END:VCALENDAR
