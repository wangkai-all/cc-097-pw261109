BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//ICS Expander Samples//Sample 2 resubscribe v2//ZH
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:示例日历二·重新订阅更新版
BEGIN:VTIMEZONE
TZID:America/New_York
LAST-MODIFIED:20260101T000000Z
BEGIN:DAYLIGHT
TZOFFSETFROM:-0500
TZOFFSETTO:-0400
TZNAME:EDT
DTSTART:19700308T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:-0400
TZOFFSETTO:-0500
TZNAME:EST
DTSTART:19701101T020000
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:weekly-ny-standup@sample
DTSTAMP:20261110T000000Z
SEQUENCE:2
SUMMARY:纽约站会（跨夏令时·时间调整为 09:30）
DESCRIPTION:重新订阅后：站会时长缩短为 15 分钟，钟点改为 09:30，SEQUENCE 升级到 2。
DTSTART;TZID=America/New_York:20261023T093000
DTEND;TZID=America/New_York:20261023T094500
RRULE:FREQ=WEEKLY;BYDAY=FR
EXDATE;TZID=America/New_York:20261127T093000
RDATE;TZID=America/New_York:20261128T100000
END:VEVENT
BEGIN:VEVENT
UID:team-sync@sample
DTSTAMP:20261110T000000Z
SEQUENCE:2
SUMMARY:团队周会（整体取消）
DESCRIPTION:主事件 METHOD 正常但 STATUS=CANCELLED；整组日程应标记取消，而不是只删一次。
STATUS:CANCELLED
DTSTART;TZID=America/New_York:20261102T140000
DTEND;TZID=America/New_York:20261102T150000
RRULE:FREQ=WEEKLY;BYDAY=MO
END:VEVENT
BEGIN:VEVENT
UID:quarterly-review@sample
DTSTAMP:20261110T000000Z
SEQUENCE:0
SUMMARY:季度复盘（新增日程）
DESCRIPTION:重新订阅后新出现的单次会议。
DTSTART;TZID=America/New_York:20261215T160000
DTEND;TZID=America/New_York:20261215T170000
END:VEVENT
BEGIN:VEVENT
UID:floating-deadline@sample
DTSTAMP:20261001T000000Z
SUMMARY:浮动时间提醒（无时区）
DTSTART:20261120T180000
DTEND:20261120T183000
END:VEVENT
END:VCALENDAR
